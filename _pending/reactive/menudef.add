// ============================================================================
// 1. Lint lines at the top of menudef. Append to the existing lines:
//      // LINT-LIVE: RSBManual RSBReactive
//      // LINT-LIVE-OK: ... gl_bloom_override_strength
//      and also  gl_bloom_step  on the LINT-LIVE-OK line.
//    Both are engine cvars the renderer reads every frame.
//
// 1b. In OptionMenu "RSBManual", REPLACE the two Spread note lines
//      StaticText "Blur radius -- how far the glow reaches from what", "gray"
//      StaticText "made it. Past about 4 it stops getting wider.", "gray"
//    with:
//      StaticText "Blur radius -- how far the glow reaches from what", "gray"
//      StaticText "made it. Past about 4 it stops getting wider", "gray"
//      StaticText "unless Blur step (below) is raised.", "gray"
//      Slider "Blur step", "gl_bloom_step", 1, 8, 1, 0
//      StaticText "Lets a big Spread and the anamorphic streak keep", "gray"
//      StaticText "widening. 1 is the classic blur. Higher costs", "gray"
//      StaticText "frame time -- check the headset at 4.", "gray"
//
// 2. In OptionMenu "RSBMain", after  Submenu "By hand", "RSBManual" :
//      Submenu "Bloom that reacts", "RSBReactive"
//
// 3. Paste this menu after OptionMenu "RSBManual":
// ============================================================================

OptionMenu "RSBReactive"
{
	Title "Bloom that reacts"
	StaticText "Bloom that moves with the game: explosions and", "gray"
	StaticText "gunfire flare it, a GlowInTheDark alarm breathes", "gray"
	StaticText "it, a sweep tints it, getting hurt dims it, and", "gray"
	StaticText "dark rooms let more of it through.", "gray"
	StaticText "Each starts from your own bloom settings and goes", "gray"
	StaticText "back to them when it ends.", "gray"
	StaticText ""
	Option "Bloom that reacts", "rsb_reactive", "OnOff"
	StaticText "Changes the grab laser and Lance glow while it", "gold"
	StaticText "reacts, until laser exclusion lands.", "gold"
	StaticText ""
	Slider "Strength", "gl_bloom_override_strength", 0.0, 1.0, 0.05, 2
	StaticText "How much of every reaction shows. 0 is none. It", "gray"
	StaticText "moves live, and it is the comfort control for", "gray"
	StaticText "flashes in the headset.", "gray"
	StaticText ""
	Option "Flash", "rsb_rx_flash", "OnOff"
	StaticText "Explosions, impacts and gunfire you can see.", "gray"
	Option "Breathe", "rsb_rx_breathe", "OnOff"
	StaticText "Follows a GlowInTheDark alarm pulse.", "gray"
	Option "Sweep tint", "rsb_rx_sweep", "OnOff"
	StaticText "Leans toward a passing sweep's colour. Needs", "gray"
	StaticText "RS_Fog and the sweep's fog tint.", "gray"
	Option "Hurt", "rsb_rx_hurt", "OnOff"
	StaticText "Dims and cools while you take damage.", "gray"
	Option "Follow the dark", "rsb_rx_dark", "OnOff"
	StaticText "More bloom in dark rooms, less in bright ones.", "gray"
	StaticText "Changes the laser glow all the time, until laser", "gold"
	StaticText "exclusion lands.", "gold"
}
