// Presets register no handler: they are applied by the Bloom menu's own tick
// (zscript/rsb_menu.zs), because the engine refuses script writes to its
// gl_bloom_* cvars from anything that is not menu code.
//
// Bloom that reacts DOES need a handler. It never writes a cvar: it sets the
// engine's bloom override, which script may set during play.
GameInfo
{
	AddEventHandlers = "RSB_ReactiveHandler"
}
