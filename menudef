OptionMenu "RSBMain"
{
	Title "Bloom"
	StaticText "Bloom is what turns an over-bright pixel into a", "gray"
	StaticText "GLOW. Everything emissive in this family writes", "gray"
	StaticText "past 1.0 on purpose for exactly that reason -- the", "gray"
	StaticText "neon cores, the surface stamps, a wall of light.", "gray"
	StaticText "None of it reads as light until bloom picks it up.", "gray"
	StaticText ""
	Option "Use these settings", "rsb_enabled", "OnOff"
	StaticText "Off hands bloom back to whatever you had set. It", "gray"
	StaticText "does not force it dark -- this mod does not own", "gray"
	StaticText "gl_bloom, it only offers to set it.", "gray"
	StaticText ""
	Option "Preset", "rsb_preset", "RSB_Preset"
	StaticText ""
	Submenu "By hand", "RSBManual"
}

OptionMenu "RSBManual"
{
	Title "Bloom by hand"
	StaticText "These are the engine's own controls. Moving one", "gray"
	StaticText "takes effect on the next frame -- nothing has to", "gray"
	StaticText "push them.", "gray"
	StaticText ""
	Option "Bloom", "gl_bloom", "OnOff"
	StaticText ""
	Slider "Threshold", "gl_bloom_threshold", 0.05, 4.0, 0.01, 2
	StaticText "How bright a pixel must be before it blooms at", "gold"
	StaticText "all. The engine default is 1.00 -- ONLY pixels", "gold"
	StaticText "that already blew past full white. Right for a", "gold"
	StaticText "muzzle flash, wrong for anything trying to read", "gold"
	StaticText "as emissive at a sane brightness, which is most", "gold"
	StaticText "of what this family draws. Around 0.6 is where", "gold"
	StaticText "glow lanes and neon start to carry.", "gold"
	StaticText ""
	Slider "Soft knee", "gl_bloom_knee", 0.0, 8.0, 0.05, 2
	StaticText "How sharply it crosses that line. 0 is a hard", "gray"
	StaticText "cutoff, and a hard cutoff makes things POP in and", "gray"
	StaticText "out of blooming as they cross it -- constant and", "gray"
	StaticText "obvious when a glow is pulsing or a band is", "gray"
	StaticText "sweeping. Higher eases it in.", "gray"
	StaticText ""
	Slider "Spread", "gl_bloom_amount", 0.1, 6.0, 0.05, 2
	StaticText "Blur radius -- how far the glow reaches from what", "gray"
	StaticText "made it.", "gray"
	StaticText ""
	StaticText "LENS", "white"
	Option "Anamorphic streaks", "gl_bloom_anamorphic", "OnOff"
	Slider "  How sideways", "gl_bloom_anamorphic_ratio", 1.0, 16.0, 0.25, 2
	StaticText "Blurs wider horizontally than vertically, so", "gray"
	StaticText "bright things streak sideways the way they do", "gray"
	StaticText "through an anamorphic lens. Free -- the blur is", "gray"
	StaticText "already two passes and this only gives them", "gray"
	StaticText "different amounts.", "gray"
	StaticText ""
	Slider "Chromatic fringing", "gl_bloom_chromatic", 0.0, 0.1, 0.002, 3
	StaticText "Offsets the colour channels radially, so bright", "gray"
	StaticText "edges break up toward the corners the way light", "gray"
	StaticText "through glass does.", "gray"
	StaticText ""
	StaticText "TINT -- colours the bloom independently of", "white"
	StaticText "whatever produced it.", "white"
	Slider "Red", "gl_bloom_tint_r", 0.0, 2.0, 0.02, 2
	Slider "Green", "gl_bloom_tint_g", 0.0, 2.0, 0.02, 2
	Slider "Blue", "gl_bloom_tint_b", 0.0, 2.0, 0.02, 2
	StaticText ""
	StaticText "EXPOSURE -- the auto-brightness the bloom pass", "white"
	StaticText "feeds. Affects the whole image, not just glow.", "white"
	Slider "Scale", "gl_exposure_scale", 0.0, 4.0, 0.05, 2
	Slider "Minimum", "gl_exposure_min", 0.0, 2.0, 0.05, 2
	Slider "Base", "gl_exposure_base", 0.0, 2.0, 0.05, 2
	Slider "Adapt speed", "gl_exposure_speed", 0.0, 1.0, 0.01, 2
}

AddOptionMenu "OptionsMenu"
{
	Submenu "Bloom", "RSBMain"
}
